{
  "name": "milimo-claw",
  "version": "0.1.0",
  "description": "Milimo Claw — multi-agent autonomous hustle platform built on NemoClaw",
  "license": "Apache-2.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "lint": "eslint 'src/**/*.ts'",
    "lint:fix": "eslint 'src/**/*.ts' --fix",
    "format": "prettier --write 'src/**/*.ts'",
    "format:check": "prettier --check 'src/**/*.ts'",
    "check": "npm run lint && npm run format:check && tsc --noEmit",
    "clean": "rm -rf dist/",
    "test:e2e": "cd .. && docker build -t milimoclaw-sandbox . && docker run --rm -v ~/.openclaw:/sandbox/.openclaw milimoclaw-sandbox /opt/milimo/test/milimo-e2e.sh"
  },
  "dependencies": {
    "commander": "^13.1.0",
    "yaml": "^2.4.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.37",
    "@typescript-eslint/eslint-plugin": "^8.57.0",
    "@typescript-eslint/parser": "^8.57.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.1",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "files": [
    "dist/",
    "openclaw.plugin.json"
  ]
}
