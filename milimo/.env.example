# MilimoClaw CLI Environment Configuration
# NOTE: For Docker/Project-wide config, use root .env file
# This file is for local CLI development only

# =============================================================================
# Stripe Keys (For Payment Processing)
# =============================================================================
# Get from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your_secret_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# =============================================================================
# Server Configuration
# =============================================================================
# Production server URL - used for payment API calls
# Override with MILIMO_SERVER_URL environment variable or config.json serverUrl field
# Default: https://api.milimoclaw.com
MILIMO_SERVER_URL=https://api.milimoclaw.com

# Uncomment for local development
# MILIMO_SERVER_URL=http://localhost:3001

PORT=3001
