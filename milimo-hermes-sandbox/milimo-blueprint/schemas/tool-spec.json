{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://milimo.claw/schemas/tool-spec.json",
  "title": "Milimo Claw Tool Specification",
  "description": "Schema for evolved tool specifications generated by the self-evolution engine",
  "type": "object",
  "required": ["name", "version", "tool_type", "description", "inputs", "outputs", "permissions", "metadata"],
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$",
      "minLength": 3,
      "maxLength": 64,
      "description": "Unique tool identifier, snake_case",
      "examples": ["tone_classifier", "deadline_predictor", "rate_optimizer"]
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "default": "0.1.0",
      "description": "Semantic version of the tool"
    },
    "tool_type": {
      "type": "string",
      "enum": ["classifier", "predictor", "optimizer", "detector", "generator", "transformer", "aggregator"],
      "description": "Category of tool functionality"
    },
    "description": {
      "type": "string",
      "minLength": 10,
      "maxLength": 500,
      "description": "Human-readable description of what the tool does"
    },
    "inputs": {
      "type": "object",
      "description": "Input specification for the tool",
      "required": ["schema"],
      "properties": {
        "schema": {
          "type": "object",
          "description": "JSON Schema for tool inputs",
          "additionalProperties": true
        },
        "examples": {
          "type": "array",
          "items": {
            "type": "object"
          },
          "description": "Example inputs for documentation and testing"
        }
      }
    },
    "outputs": {
      "type": "object",
      "description": "Output specification for the tool",
      "required": ["schema"],
      "properties": {
        "schema": {
          "type": "object",
          "description": "JSON Schema for tool outputs",
          "additionalProperties": true
        },
        "examples": {
          "type": "array",
          "items": {
            "type": "object"
          },
          "description": "Example outputs for documentation and testing"
        }
      }
    },
    "permissions": {
      "type": "object",
      "description": "Permissions required by the tool",
      "required": ["filesystem", "network"],
      "properties": {
        "filesystem": {
          "type": "object",
          "description": "Filesystem access requirements",
          "properties": {
            "read": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "default": [],
              "description": "Paths the tool needs read access to"
            },
            "write": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "default": [],
              "description": "Paths the tool needs write access to"
            }
          }
        },
        "network": {
          "type": "object",
          "description": "Network access requirements",
          "properties": {
            "egress": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "host": {
                    "type": "string"
                  },
                  "port": {
                    "type": "integer"
                  },
                  "purpose": {
                    "type": "string"
                  }
                },
                "required": ["host"]
              },
              "default": [],
              "description": "External hosts the tool needs to connect to"
            }
          }
        },
        "data_access": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["client_contacts", "financial_data", "source_code", "analytics_data", "public_content", "internal_drafts"]
          },
          "default": [],
          "description": "Types of sensitive data the tool accesses"
        }
      }
    },
    "implementation": {
      "type": "object",
      "description": "Implementation details",
      "properties": {
        "language": {
          "type": "string",
          "enum": ["python", "typescript"],
          "default": "python",
          "description": "Programming language of the tool"
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "External packages required"
        },
        "code": {
          "type": "string",
          "description": "Generated tool code (base64 encoded if binary)"
        },
        "entry_point": {
          "type": "string",
          "description": "Function name to call",
          "default": "run"
        }
      }
    },
    "testing": {
      "type": "object",
      "description": "Testing requirements and results",
      "properties": {
        "test_cases": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["input", "expected_output"],
            "properties": {
              "name": {
                "type": "string"
              },
              "input": {
                "type": "object"
              },
              "expected_output": {
                "type": "object"
              },
              "validation": {
                "type": "string",
                "enum": ["exact", "partial", "schema_only", "custom"],
                "default": "schema_only"
              }
            }
          },
          "default": []
        },
        "backtest_results": {
          "type": "object",
          "description": "Results from historical data backtest",
          "properties": {
            "sample_size": {
              "type": "integer"
            },
            "performance_delta": {
              "type": "number",
              "description": "Percentage improvement over baseline"
            },
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "Statistical confidence in results"
            },
            "false_positive_rate": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "false_negative_rate": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        }
      }
    },
    "metadata": {
      "type": "object",
      "description": "Metadata about the tool",
      "required": ["created_at", "claw_role", "evolution_cycle"],
      "properties": {
        "created_at": {
          "type": "string",
          "format": "date-time",
          "description": "When the tool was generated"
        },
        "claw_role": {
          "type": "string",
          "enum": ["content", "ops", "analytics", "finance", "build"],
          "description": "Which claw role generated this tool"
        },
        "evolution_cycle": {
          "type": "string",
          "description": "ID of the evolution cycle that produced this tool"
        },
        "pattern_source": {
          "type": "string",
          "description": "The pattern that triggered tool creation"
        },
        "author": {
          "type": "string",
          "default": "self-evolution",
          "description": "Tool author (usually 'self-evolution')"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Tags for categorization"
        },
        "deprecated": {
          "type": "boolean",
          "default": false,
          "description": "Whether the tool is deprecated"
        },
        "replacement": {
          "type": "string",
          "description": "Name of replacement tool if deprecated"
        }
      }
    },
    "audit": {
      "type": "object",
      "description": "Security and performance audit results",
      "properties": {
        "security_review": {
          "type": "object",
          "properties": {
            "passed": {
              "type": "boolean"
            },
            "issues": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "severity": {
                    "type": "string",
                    "enum": ["low", "medium", "high", "critical"]
                  },
                  "description": {
                    "type": "string"
                  },
                  "resolution": {
                    "type": "string"
                  }
                }
              }
            },
            "reviewed_at": {
              "type": "string",
              "format": "date-time"
            },
            "reviewer": {
              "type": "string"
            }
          }
        },
        "performance_benchmark": {
          "type": "object",
          "properties": {
            "avg_latency_ms": {
              "type": "number"
            },
            "p99_latency_ms": {
              "type": "number"
            },
            "memory_peak_mb": {
              "type": "number"
            },
            "cpu_peak_percent": {
              "type": "number"
            }
          }
        }
      }
    }
  }
}
