    "milimo-blueprint/",
    "milimo-server/dist/",
    "milimo-server/package.json",
    "scripts/",
    "Dockerfile",
    ".dockerignore"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mainzak/MilimoClaw.git"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@j178/prek": "^0.3.6",
    "@vitest/coverage-v8": "^4.1.0",
    "vitest": "^4.1.0"
