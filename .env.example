# MilimoClaw Environment Configuration
# Copy to .env and fill in your values

# =============================================================================
# NVIDIA NIM API (Required for Cloud Inference)
# =============================================================================
# Get your API key from: https://build.nvidia.com/
NVIDIA_API_KEY=nvapi-your-key-here

# =============================================================================
# Stripe Keys (For Payment Processing)
# =============================================================================
# Get from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your_secret_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# =============================================================================
# Server Configuration
# =============================================================================
# Required: Generate with `openssl rand -hex 32`
JWT_SECRET=your-64-character-hex-secret-here

# Comma-separated list of allowed CORS origins (no spaces)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

MILIMO_SERVER_URL=http://localhost:3001
PORT=3001

# =============================================================================
# GitHub CLI (For Build Claw GitHub Integration)
# =============================================================================
# Personal Access Token (classic) with repo scope
# Generate from: https://github.com/settings/tokens
GITHUB_TOKEN=ghp_your_token_here

# =============================================================================
# Analytics Data Collectors (Optional)
# =============================================================================
# YouTube Data API v3 key: https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=
# Google Analytics 4 property ID
GA_PROPERTY_ID=
# Path to GA4 service account credentials JSON file
GA_CREDENTIALS_PATH=

# =============================================================================
# Squad Configuration
# =============================================================================
# Squad identifier (default: zulu)
SQUAD_ID=zulu

# =============================================================================
# Optional: Development Settings
# =============================================================================
# Set to 'true' for Docker testing on macOS (uses cloud inference for all routes)
DOCKER_TESTING=false
