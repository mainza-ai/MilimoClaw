# MilimoClaw Environment Configuration
# Copy to .env and fill in your values

# =============================================================================
# NVIDIA NIM API (Required for Cloud Inference)
# =============================================================================
# Get your API key from: https://build.nvidia.com/
NVIDIA_API_KEY=nvapi-your-key-here

# Dedicated key for build claw
BUILD_CLAW_NVIDIA_API_KEY=nvapi-your-key-here

# =============================================================================
# Stripe Keys (For Payment Processing)
# =============================================================================
# Get from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your_secret_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# =============================================================================
# Server Configuration
# =============================================================================
# Required: Generate with `openssl rand -hex 32`
JWT_SECRET=your-64-character-hex-secret-here

# Comma-separated list of allowed CORS origins (no spaces)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

MILIMO_SERVER_URL=http://localhost:3001
PORT=3001

# =============================================================================
# GitHub CLI (For Build Claw GitHub Integration)
# =============================================================================
# Personal Access Token (classic) with repo scope
# Generate from: https://github.com/settings/tokens
GITHUB_TOKEN=ghp_your_token_here
GH_TOKEN=ghp_your_token_here
# Repository in owner/repo format (NOT the full URL)
GITHUB_REPO=owner/repo

# =============================================================================
# Vercel (Optional - for Build Claw deployments)
# =============================================================================
# Get from https://vercel.com/account/tokens
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=

# =============================================================================
# Sentry (Optional - for error monitoring)
# =============================================================================
# Get from https://sentry.io/settings/account/api/auth-tokens/
SENTRY_AUTH_TOKEN=
SENTRY_ORG_SLUG=
SENTRY_PROJECT_SLUG=

# =============================================================================
# Telegram Bot (Optional)
# =============================================================================
# Get from @BotFather on Telegram
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_ID=

# =============================================================================
# Analytics Data Collectors (Optional)
# =============================================================================
# YouTube Data API v3 key: https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=
# Google Analytics 4 property ID
GA_PROPERTY_ID=
# Path to GA4 service account credentials JSON file
GA_CREDENTIALS_PATH=

# =============================================================================
# Squad Configuration
# =============================================================================
# Squad identifier (default: zulu)
SQUAD_ID=zulu

# =============================================================================
# Optional: Development Settings
# =============================================================================
# Set to 'true' for Docker testing on macOS (uses cloud inference for all routes)
DOCKER_TESTING=false

# =============================================================================
# Multi-User Stripe Link CLI Credentials Isolation
# =============================================================================
# The identifier of the human operator (e.g. john, alice).
# Isolates credentials to /sandbox/.config/users/${MILIMO_OPERATOR}
MILIMO_OPERATOR=

# Set to 'true' to force Stripe Link CLI to run all commands in test mode
MILIMO_SPEND_TEST_MODE=true

# Daily spend cap in cents (default: 10000 = $100.00). Set to 0 for unlimited.
MILIMO_DAILY_SPEND_CAP_CENTS=10000

# =============================================================================
# Hermes Sandbox Settings
# =============================================================================
NEMOCLAW_AGENT=hermes
NEMOCLAW_NON_INTERACTIVE=1
NEMOCLAW_ACCEPT_THIRD_PARTY_SOFTWARE=1
CHAT_UI_URL=http://127.0.0.1:18789
NEMOCLAW_AUTH_MODE=api_key
NEMOCLAW_MODEL=stepfun-ai/step-3.7-flash
# Inference provider ID — NemoClaw v0.0.90+ uses this for the non-secret route selector.
# Set to match your inference provider name (e.g. "custom", "nvidia", "openai").
# Falls back to NEMOCLAW_MODEL-based legacy selector when unset.
NEMOCLAW_INFERENCE_PROVIDER_ID=custom
