# MilimoClaw Environment Configuration
# Copy to .env and fill in your values

# =============================================================================
# NVIDIA NIM API (Required for Cloud Inference)
# =============================================================================
# Get your API key from: https://build.nvidia.com/
NVIDIA_API_KEY=nvapi-your-key-here

# =============================================================================
# Stripe Keys (For Payment Processing)
# =============================================================================
# Get from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your_secret_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# =============================================================================
# Server Configuration
# =============================================================================
MILIMO_SERVER_URL=http://localhost:3001
PORT=3001

# =============================================================================
# Optional: Development Settings
# =============================================================================
# Set to 'true' for Docker testing on macOS (uses cloud inference for all routes)
DOCKER_TESTING=false
