# Milimo Claw Secrets Template
# Copy to milimo-secrets.yaml and fill in values
# DO NOT commit this file with real secrets

apiVersion: v1
kind: Secret
metadata:
  name: milimo-secrets
  namespace: openshell
type: Opaque
stringData:
  nvidia-api-key: "nvapi-YOUR_KEY_HERE"
  nemoclaw-model: "nvidia/nemotron-3-super-120b-a12b"
  chat-ui-url: "http://127.0.0.1:18789"
